  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/ssg.mjs",
    "dev": "node scripts/generate-routes.mjs && vp dev",
    "preview": "vp preview --outDir out",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
