    "delaunator": "^5.1.0",
    "framer-motion": "latest",
    "json5": "^2.2.3",
    "jsonrepair": "^3.13.2",
    "lucide-react": "^0.454.0",
    "lz-string": "^1.5.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "2.15.4",
    "roughjs": "^4.6.6",
